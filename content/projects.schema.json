{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Isaac Nino portfolio projects",
  "type": "object",
  "required": [
    "projects"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "category",
          "summary",
          "tags",
          "role",
          "focus",
          "status",
          "problem",
          "approach",
          "outcome",
          "links"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
            "description": "Unique stable slug. Used in shareable #project/slug links."
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "type": "string",
            "minLength": 1,
            "description": "Creates a filter automatically. Do not use the reserved name All work."
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "featured": {
            "type": "boolean",
            "default": false,
            "description": "Legacy compatibility field; array order controls the current scroll showcase."
          },
          "accent": {
            "enum": [
              "acid",
              "amber",
              "blue",
              "sage"
            ],
            "description": "Legacy compatibility field; the current layout uses its shared graphite and icy-blue palette."
          },
          "tags": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "image": {
            "type": "object",
            "required": [
              "src",
              "alt"
            ],
            "properties": {
              "src": {
                "type": "string",
                "description": "Local ./assets/images/... path or HTTPS image URL."
              },
              "alt": {
                "type": "string",
                "minLength": 1
              },
              "fit": {
                "enum": [
                  "cover",
                  "contain"
                ],
                "default": "cover",
                "description": "Use contain to preserve the full artwork or portrait media."
              }
            }
          },
          "role": {
            "type": "string",
            "minLength": 1
          },
          "focus": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "minLength": 1
          },
          "problem": {
            "type": "string",
            "minLength": 1
          },
          "approach": {
            "type": "string",
            "minLength": 1
          },
          "outcome": {
            "type": "string",
            "minLength": 1
          },
          "links": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "label",
                "url"
              ],
              "properties": {
                "label": {
                  "type": "string",
                  "minLength": 1
                },
                "url": {
                  "type": "string",
                  "format": "uri",
                  "pattern": "^https://"
                }
              }
            }
          },
          "credit": {
            "type": "string",
            "minLength": 1,
            "description": "Agency or collaboration credit, separate from your personal role."
          },
          "video": {
            "type": "object",
            "required": [
              "src",
              "alt"
            ],
            "properties": {
              "src": {
                "type": "string",
                "description": "Local ./assets/videos/...mp4 or HTTPS MP4 URL. Keep image as a still poster."
              },
              "alt": {
                "type": "string",
                "minLength": 1
              }
            },
            "description": "Optional muted project film. Uses image as its poster; plays only while visible."
          }
        },
        "dependentRequired": {
          "video": [
            "image"
          ]
        }
      }
    }
  }
}
